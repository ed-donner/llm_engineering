        "from urllib.parse import urljoin\n",
        "\n",
        "def normalize_relevant_links(parsed, base_url):\n",
        "    \"\"\"Ollama may return links as dicts or plain URL strings — normalize both.\"\"\"\n",
        "    raw_links = parsed.get(\"links\", [])\n",
        "    if isinstance(raw_links, dict):\n",
        "        raw_links = [raw_links]\n",
        "\n",
        "    normalized = []\n",
        "    for item in raw_links:\n",
        "        if isinstance(item, str):\n",
        "            link_url = urljoin(base_url, item)\n",
        "            link_type = \"web page\"\n",
        "        elif isinstance(item, dict):\n",
        "            link_url = item.get(\"url\") or item.get(\"href\") or \"\"\n",
        "            link_type = item.get(\"type\") or item.get(\"name\") or \"web page\"\n",
        "            link_url = urljoin(base_url, link_url) if link_url else \"\"\n",
        "        else:\n",
        "            continue\n",
        "\n",
        "        if link_url.startswith((\"http://\", \"https://\")):\n",
        "            normalized.append({\"type\": link_type, \"url\": link_url})\n",
        "\n",
        "    return {\"links\": normalized}\n",
        "\n",
        "\n",
        "def select_relevant_links(url):\n",
        "    response = ollama.chat.completions.create(\n",
        "        model=MODEL,\n",
        "        messages=[\n",
        "            {\"role\": \"system\", \"content\": link_system_prompt},\n",
        "            {\"role\": \"user\", \"content\": get_links_user_prompt(url)}\n",
        "        ],\n",
        "        response_format={\"type\": \"json_object\"}\n",
        "    )\n",
        "    result = response.choices[0].message.content\n",
        "    return normalize_relevant_links(json.loads(result), url)"
      ]
    },
