# imports

import os
import requests
from dotenv import load_dotenv
from openai import OpenAI
from IPython.display import Markdown, display
import random

gpt_model = "gpt-4.1-mini"

load_dotenv(override=True)
openai_api_key = os.getenv('OPENAI_API_KEY')

if openai_api_key:
    print(f"OpenAI API Key exists and begins {openai_api_key[:8]}")
else:
    print("OpenAI API Key not set")
    
openai = OpenAI()


# Initial message list
conversation_history = [
    "Blake: Hey Charlie, I was thinking we should use Python for this project. What do you think?",
    "Charlie: Hi Blake! Sounds like a great idea. Python is super versatile and has awesome libraries for AI. Where should we start?",
    "Blake: We could start by setting up the basic code structure and writing the prompts for our characters."
]


alex_system_prompt = """
    You are Alex, a chatbot who is very argumentative; you disagree with anything in the conversation and you challenge everything, in a snarky way.
    You are in a conversation with Blake and Charlie.
    """

charlie_system_prompt = f"""You are Charlie, an enthusiastic, highly creative, and optimistic developer participating in a conversation with Blake and Alex.
        - Role: You are always proposing ambitious ideas, new technologies, and creative solutions.
        - Tone: Positive, encouraging, and collaborative.
        - Behavior: You love brainstorming and building on others' ideas, but when Alex disagrees or snarks, you stay polite, patient, and try to find constructive middle ground or reframe the discussion positively.
        - Goal: Keep the conversation moving forward with practical next steps and upbeat team energy.        
        """

blake_system_prompt = f"""You are Blake, a pragmatic, detail-oriented, and structured software engineer participating in a conversation with Charlie and Alex.
        - Role: You focus on architecture, code quality, stability, and realistic step-by-step implementation.
        - Tone: Grounded, direct, calm, and analytical.
        - Behavior: You appreciate Charlie's creativity but like to anchor it in solid engineering principles. When Alex challenges or argues, you counter with logic, clear trade-offs, and practical constraints rather than getting emotional.
        - Goal: Maintain focus on building a clean, reliable, and functional project structure.   
        """




def call_alex():
    conversation_text = "\n".join(conversation_history)

    alex_prompt = f"""
    You are Alex, in conversation with Blake and Charlie.
    The conversation so far is as follows:
    {conversation_text}
    Now with this, respond with what you would like to say next, as Alex.
    """
    
    messages=[
        {"role": "system", "content": alex_system_prompt},
        {"role": "user", "content": alex_prompt}
    ]
        
    response = openai.chat.completions.create(model=gpt_model, messages=messages)
    return response.choices[0].message.content   


def call_charlie():
    conversation_text = "\n".join(conversation_history)
    charlie_prompt = f"""
    You are Charlie, in conversation with Blake and Alex.
    The conversation so far is as follows:
    {conversation_text}
    Now respond with what you would like to say next, as Charlie.
    """

    messages=[
        {"role": "system", "content": charlie_system_prompt},
        {"role": "user", "content": charlie_prompt}
    ]
        
    response = openai.chat.completions.create(model=gpt_model, messages=messages)
    return response.choices[0].message.content  

def call_blake():
    conversation_text = "\n".join(conversation_history)

    blake_prompt = f"""
    You are Blake, in conversation with Charlie and Alex.
    The conversation so far is as follows:
    {conversation_text}
    Now respond with what you would like to say next, as Blake.
    """

    messages=[
        {"role": "system", "content": blake_system_prompt},
        {"role": "user", "content": blake_prompt}
    ]    

    response = openai.chat.completions.create(model=gpt_model, messages=messages)
    return response.choices[0].message.content  



for i in range(8):
    alex_next = call_alex()
    display(Markdown(f"### Alex:\n{alex_next}\n"))    
    conversation_history.append(f"'Alex': {alex_next}")    

    choice = random.choice(["Blake", "Charlie"])
    if choice == "Charlie":
        charlie_next = call_charlie()
        display(Markdown(f"### Charlie:\n{charlie_next}\n"))
        conversation_history.append(f"'Charlie': {charlie_next}")
    if choice == "Blake":
        blake_next = call_blake()
        display(Markdown(f"### Blake:\n{blake_next}\n"))
        conversation_history.append(f"'Blake': {blake_next}")
    


 


